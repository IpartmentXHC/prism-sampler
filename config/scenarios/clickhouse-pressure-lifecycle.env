# One ClickHouse lifecycle for NUMA node pressure scaling.
SCENARIO_NAME=clickhouse_pressure_lifecycle
SCENARIO_BUDGET_MODE=duration
SCENARIO_PHASES='low_start middle_up high middle_down low_finish'

SCENARIO_MIN_PHASE_SECONDS=60
SCENARIO_TIMEOUT_GRACE_SECONDS=30
SCENARIO_DURATION_TOLERANCE_SECONDS=2
SCENARIO_DURATION_OPERATIONCOUNT_PER_CLIENT=2147483647

SCENARIO_PHASE_low_start_CLIENTS=2
SCENARIO_PHASE_low_start_THREADS=2
SCENARIO_PHASE_low_start_VALUE=300

SCENARIO_PHASE_middle_up_CLIENTS=4
SCENARIO_PHASE_middle_up_THREADS=6
SCENARIO_PHASE_middle_up_VALUE=300

SCENARIO_PHASE_high_CLIENTS=5
SCENARIO_PHASE_high_THREADS=16
SCENARIO_PHASE_high_VALUE=300

SCENARIO_PHASE_middle_down_CLIENTS=4
SCENARIO_PHASE_middle_down_THREADS=6
SCENARIO_PHASE_middle_down_VALUE=300

SCENARIO_PHASE_low_finish_CLIENTS=2
SCENARIO_PHASE_low_finish_THREADS=2
SCENARIO_PHASE_low_finish_VALUE=300
