[experiment]
output_root = "/data/threadState/experiments"
system = "doris"

[target]
host = "kunpen183"
sudo = "SUDO_ASKPASS=/absolute/path/to/askpass.sh sudo -A"
remote_root = "/home/user/prism-sampler/data"
agent_command = "/home/user/.local/bin/prism-sampler-agent"
live_analyzer_command = "/home/user/.local/bin/prism-live-analyzer"
# Optional command prefix for affinity changes that require privilege.
controller_command_prefix = "SUDO_ASKPASS=/absolute/path/to/askpass.sh sudo -A"

[client]
host = "ubuntu197"
hook_command = "/home/user/.local/bin/prism-sampler-hook"
kpi_forwarder_command = "/home/user/.local/bin/prism-kpi-forwarder"
sampler_config = "/home/user/.config/prism-sampler/local.toml"
output_root = "/home/user/.local/share/prism-sampler/experiments"

[collector]
binary = "/home/user/prism/bin/metric-collector"
# Optional calibration override; omitted values preserve the platform defaults.
# subsystems = ["taskstats"]
# required_subsystems = ["taskstats"]
# best_effort = true
runtime_lib = "/home/user/prism/lib"
attach_wait_seconds = 12
stop_timeout_seconds = 30

[yba]
root = "/home/user/ycsb-bench-all-database"

[sampling]
profile = "policy"
interval_seconds = 10
platform = "kunpeng-920"

[relations]
live_interval_ms = 1000
live_queue_capacity = 64
window_seconds = 60
stability_window_seconds = 10
emit_seconds = 10
minimum_evidence_windows = 3
record_snapshots = true
# Optional fixed scales generated by offline relation calibration on the target.
# scales_file = "/home/user/prism-sampler/relation-scales.json"
# Optional rules; unmatched comm values remain separate groups.
# group_rules = [{ name = "QueryPipeline", pattern = "^QueryPipeline" }]

[controller]
mode = "off"
sample_interval_seconds = 10
decision_window_samples = 3
one_node_nodes = [0]
two_node_nodes = [0, 1]
expand_run_pressure = 0.90
expand_rq_pressure = 0.50
shrink_run_cpu_equiv = 24.0
shrink_rq_pressure = 0.05
shrink_confirm_seconds = 180
minimum_two_node_dwell_seconds = 300
cooldown_seconds = 120
actuator = "taskset"
migrate_pages = false
agent_command = "/home/user/prism-sampler/bin/prism-numa-controller"
